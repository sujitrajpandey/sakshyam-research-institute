---
export interface Props {
  insight: any;
}
const { insight } = Astro.props;
const { data } = insight;
const formattedDate = data.date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<a href={`/insights/${data.slug}`} class="card p-7 flex flex-col h-full group">
  <span class="tag mb-4 w-fit">{data.category}</span>
  <h3 class="h4 mb-2.5 group-hover:underline decoration-1 underline-offset-4">{data.title}</h3>
  <p class="prose-body text-[0.95rem] flex-1">{data.summary}</p>
  <span class="mt-5 text-sm font-medium" style="color: var(--color-ink-soft);">{formattedDate}</span>
</a>
