---
interface Props {
  event: {
    title: string;
    date: string;
    location?: string;
    type?: string;
    image?: string;
    description?: string;
    slug?: string;
  };
}

const { event } = Astro.props;

const eventUrl = event.slug ? `/events/${event.slug}` : '#';
---

<article class="group flex flex-col h-full">

  <!-- Event image -->
  {
    event.image && (
      <a
        href={eventUrl}
        class="block aspect-[4/3] overflow-hidden rounded-2xl bg-[var(--color-bg-soft)] mb-5"
      >
        <img
          src={event.image}
          alt={event.title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          loading="lazy"
        />
      </a>
    )
  }

  <!-- Event details -->
  <div class="flex flex-col flex-1">

    <!-- Date / type -->
    <div class="flex items-center gap-3 mb-3">
      {
        event.type && (
          <span class="eyebrow">
            {event.type}
          </span>
        )
      }

      <span class="text-sm text-[var(--color-muted)]">
        {event.date}
      </span>
    </div>

    <!-- Title -->
    <h3 class="h4 mb-3">
      <a
        href={eventUrl}
        class="transition-colors hover:text-[var(--color-teal-deep)]"
      >
        {event.title}
      </a>
    </h3>

    <!-- Location -->
    {
      event.location && (
        <p class="text-sm text-[var(--color-muted)] mb-3">
          {event.location}
        </p>
      )
    }

    <!-- Description -->
    {
      event.description && (
        <p class="prose-body text-[0.95rem] mt-auto">
          {event.description}
        </p>
      )
    }

  </div>

</article>
