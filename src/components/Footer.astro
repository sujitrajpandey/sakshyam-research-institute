---
export interface Props {
  settings: any;
}
const { settings } = Astro.props;

const exploreLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'People', href: '/people' },
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'Insights', href: '/insights' },
];
---

<footer class="mt-24" style="background-color: var(--color-ink);">
  <div class="wrap py-16 grid gap-12 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <img src={settings.logo_mark} alt={settings.site_title} class="h-10 w-auto mb-5" />
      <p class="text-white/90 font-heading text-lg leading-snug mb-3">{settings.site_title}</p>
      <p class="text-white/60 text-sm leading-relaxed max-w-xs">
        {settings.footer_blurb}
      </p>
    </div>

    <div>
      <p class="text-white/40 text-xs font-semibold uppercase tracking-[0.14em] mb-4">Explore</p>
      <ul class="space-y-2.5">
        {
          exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/75 hover:text-white text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-white/40 text-xs font-semibold uppercase tracking-[0.14em] mb-4">Connect</p>
      <ul class="space-y-2.5 text-sm">
        <li>
          <a href={`mailto:${settings.email}`} class="text-white/75 hover:text-white transition-colors">
            {settings.email}
          </a>
        </li>
        {
          settings.linkedin_url && (
            <li>
              <a href={settings.linkedin_url} target="_blank" rel="noopener noreferrer" class="text-white/75 hover:text-white transition-colors">
                LinkedIn
              </a>
            </li>
          )
        }
        <li class="text-white/50">{settings.location_text}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/40">
      <span>{settings.copyright_text}</span>
      <span>Evidence. Implementation. Inclusion.</span>
    </div>
  </div>
</footer>
