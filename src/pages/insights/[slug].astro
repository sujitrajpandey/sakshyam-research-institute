---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map((insight) => ({
    params: { slug: insight.data.slug },
    props: { insight },
  }));
}

const { insight } = Astro.props;
const { data } = insight;
const formattedDate = data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Layout title={data.title} description={data.summary}>
  <section class="wrap pt-14 pb-10 md:pt-20 md:pb-12">
    <a href="/insights" class="text-sm font-semibold mb-8 inline-flex items-center gap-1.5" style="color: var(--color-teal-deep);">
      ← Back to Insights
    </a>
    <span class="tag mb-6 w-fit">{data.category}</span>
    <h1 class="h1 mb-4 max-w-3xl">{data.title}</h1>
    <p class="text-sm font-medium" style="color: var(--color-ink-soft);">{formattedDate}</p>
  </section>

  {data.image && (
    <section class="wrap pb-16">
      <img src={data.image} alt={data.title} class="w-full rounded-2xl" />
    </section>
  )}

  <section class="pb-24">
    <div class="wrap">
      <div class="prose-body max-w-2xl">
        <p>{data.body}</p>
      </div>
    </div>
  </section>
</Layout>
