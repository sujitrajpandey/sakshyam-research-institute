---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const projects=(await getCollection('projects')).sort((a,b)=>(b.data.year||'').localeCompare(a.data.year||''));
---
<Layout title="Projects"><section class="page-hero"><div class="container"><div class="eyebrow">Projects</div><h1>Work that travels from question to evidence.</h1><p>Explore selected research, evaluation and policy assignments across entrepreneurship, finance, institutions and inclusive growth.</p></div></section><section class="section"><div class="container"><div class="grid project-grid">{projects.map(p=><a class="project" href={`/projects/${p.id}`}><div>{p.data.image ? <img class="project-image" src={p.data.image} alt=""/> : <div class="project-image"></div>}</div><div class="project-body"><span class="pill">{p.data.status || 'Project'}{p.data.year ? ` · ${p.data.year}`:''}</span><h3>{p.data.title}</h3><p>{p.data.summary}</p></div></a>)}</div></div></section></Layout>
