---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---
<Layout title={`${project.data.title} - Sakshyam Research Institute`}>
  <div class="max-w-4xl mx-auto py-16 px-4">
    <a href="/projects" class="text-teal-600 hover:text-slate-900 mb-8 inline-block font-bold">&larr; Back to All Projects</a>
    
    <div class="bg-white shadow-sm rounded-lg p-8 md:p-12 border-t-4 border-slate-900">
        <h1 class="text-4xl font-heading font-bold text-slate-900 mb-8">{project.data.title}</h1>
        
        {project.data.cover_image && (
            <img src={project.data.cover_image} alt={project.data.title} class="w-full h-64 object-cover rounded-lg mb-8" />
        )}

        <div class="prose prose-lg text-slate-900 max-w-none space-y-4">
            <Content />
        </div>
    </div>
  </div>
</Layout>
