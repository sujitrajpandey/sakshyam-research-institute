---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About Us"><section class="page-hero"><div class="container"><div class="eyebrow">{page?.data.eyebrow}</div><h1>{page?.data.heroTitle}</h1><p>{page?.data.heroText}</p></div></section><section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Our purpose</div><h2>Ask better questions.</h2></div><div class="prose">{Content && <Content />}</div></div><div class="grid pillar-grid"><article class="pillar"><div class="pillar-no">01</div><h3>Question</h3><p>Frame the decision, problem or opportunity before choosing the method.</p></article><article class="pillar"><div class="pillar-no">02</div><h3>Method</h3><p>Use appropriate qualitative, quantitative and mixed methods to build credible evidence.</p></article><article class="pillar"><div class="pillar-no">03</div><h3>Context</h3><p>Interpret evidence through institutions, incentives, markets and lived realities.</p></article></div></div></section><section class="section" style="background:var(--mist)"><div class="container"><div class="section-head"><div><div class="eyebrow">How we work</div><h2>From evidence to impact.</h2></div><p>We believe research creates value when it improves decisions, strengthens implementation and makes participation and outcomes more inclusive.</p></div><div class="grid" style="grid-template-columns:repeat(4,1fr)"><article class="pillar"><div class="pillar-no">01</div><h3>Listen</h3><p>Understand the problem from multiple perspectives.</p></article><article class="pillar"><div class="pillar-no">02</div><h3>Investigate</h3><p>Generate and test evidence using appropriate methods.</p></article><article class="pillar"><div class="pillar-no">03</div><h3>Translate</h3><p>Turn findings into clear implications and usable knowledge.</p></article><article class="pillar"><div class="pillar-no">04</div><h3>Learn</h3><p>Build feedback loops that improve future decisions.</p></article></div></div></section><section class="section" id="contact"><div class="container"><div class="cta"><div class="cta-inner"><div><div class="eyebrow" style="color:#d7f1f3">Contact</div><h2>{page?.data.ctaTitle}</h2><p>{page?.data.ctaText}</p></div><a class="btn" style="background:white;border-color:white" href={page?.data.ctaUrl}>{page?.data.ctaLabel}</a></div></div></div></section></Layout>
