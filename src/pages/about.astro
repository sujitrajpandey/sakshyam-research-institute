---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
const page = (await getCollection('pages')).find(p => p.data.pageType === 'about');
const { Content } = page ? await render(page) : { Content: null };
---
<Layout title={page?.data.title ?? 'About Us'} description={page?.data.metaDescription}>
  <section class="page-hero"><div class="container"><div class="eyebrow">{page?.data.eyebrow}</div><h1>{page?.data.heroTitle}</h1><p>{page?.data.heroText}</p></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">{page?.data.sectionEyebrow}</div><h2>{page?.data.sectionTitle}</h2></div><div class="prose">{Content && <Content />}</div></div></div></section>
  <section class="section" style="background:var(--mist)"><div class="container"><div class="section-head"><div><div class="eyebrow">{page?.data.secondaryEyebrow}</div><h2>{page?.data.secondaryTitle}</h2></div><p>{page?.data.secondaryText}</p></div></div></section>
  <section class="section" id="contact"><div class="container"><div class="cta"><div class="cta-inner"><div><div class="eyebrow" style="color:rgba(154,208,214,.95)">Contact</div><h2>{page?.data.ctaTitle}</h2><p>{page?.data.ctaText}</p></div><a class="btn" style="background:white;border-color:white" href={page?.data.ctaUrl}>{page?.data.ctaLabel}</a></div></div></div></section>
</Layout>
