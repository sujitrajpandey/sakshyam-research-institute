---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const aboutEntry = await getEntry('about', 'index');
const about = aboutEntry!.data;
---

<Layout title="About Us" description={about.hero.subheading}>
  <section class="wrap pt-14 pb-16 md:pt-20 md:pb-20">
    <p class="eyebrow mb-5">{about.hero.eyebrow}</p>
    <h1 class="h1 mb-6 max-w-3xl">{about.hero.heading}</h1>
    <p class="lede max-w-2xl">{about.hero.subheading}</p>
  </section>

  <section class="section-soft py-20">
    <div class="wrap grid md:grid-cols-[1fr_1.4fr] gap-8 md:gap-16 items-start">
      <div>
        <p class="eyebrow mb-4">{about.purpose.eyebrow}</p>
        <h2 class="h2">{about.purpose.heading}</h2>
      </div>
      <p class="lede">{about.purpose.body}</p>
    </div>
  </section>

  <section class="py-20">
    <div class="wrap grid md:grid-cols-[1fr_1.4fr] gap-8 md:gap-16 items-start">
      <div>
        <p class="eyebrow mb-4">{about.how_we_work.eyebrow}</p>
        <h2 class="h2">{about.how_we_work.heading}</h2>
      </div>
      <p class="lede">{about.how_we_work.body}</p>
    </div>
  </section>

  <section id="contact" class="py-20 md:py-24">
    <div class="wrap">
      <div class="rounded-3xl px-8 py-16 md:px-16 md:py-20 text-center" style="background-color: var(--color-ink);">
        <p class="eyebrow mb-5" style="color: var(--color-teal-light);">{about.contact.eyebrow}</p>
        <h2 class="h2 mb-6 text-white">{about.contact.heading}</h2>
        <p class="lede mb-9 max-w-xl mx-auto text-white/70">{about.contact.body}</p>
        <a href={`mailto:${about.contact.email}`} class="btn" style="background-color: var(--color-teal); color: white;">
          {about.contact.email} →
        </a>
      </div>
    </div>
  </section>
</Layout>
