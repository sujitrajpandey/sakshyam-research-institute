---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const aboutContent = await getEntry('pages', 'about');
const { Content } = await aboutContent.render();
---
<Layout title="About Us - Sakshyam Research Institute">
  <div class="max-w-4xl mx-auto py-16 px-4">
    <h1 class="text-4xl font-heading font-bold text-slate-900 mb-10 text-center relative">
        <span class="relative z-10 bg-background px-4">{aboutContent.data.title}</span>
        <div class="absolute top-1/2 left-0 w-full h-0.5 bg-teal-600 -z-10"></div>
    </h1>
    
    <div class="prose prose-lg text-slate-900 mx-auto space-y-6 bg-white p-8 md:p-12 shadow-sm rounded-lg">
      <Content />
    </div>
  </div>
</Layout>
