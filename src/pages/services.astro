---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Services" description="Research, evaluation, policy and strategy services from Sakshyam Research Institute.">
  <section class="wrap pt-14 pb-16 md:pt-20 md:pb-20">
    <p class="eyebrow mb-5">Services</p>
    <h1 class="h1 mb-6 max-w-3xl">Research built for decisions.</h1>
    <p class="lede max-w-2xl">
      From research design and evaluation to policy and organizational strategy, we help clients turn difficult
      questions into actionable knowledge.
    </p>
  </section>

  <section class="pb-24">
    <div class="wrap flex flex-col gap-6">
      {
        services.map((service, i) => (
          <div class={`card p-8 md:p-12 grid md:grid-cols-[auto_1fr] gap-6 md:gap-12 ${i % 2 === 1 ? 'section-soft' : ''}`}>
            <span class="font-heading text-4xl md:text-5xl" style="color: var(--color-teal-mid);">
              {service.data.number}
            </span>
            <div>
              <h2 class="h2 mb-4">{service.data.title}</h2>
              <p class="lede mb-7">{service.data.summary}</p>
              <div class="grid sm:grid-cols-2 gap-y-2 gap-x-8 mb-7">
                {service.data.bullets.map((bullet) => (
                  <div class="flex items-start gap-2.5 text-[0.95rem]" style="color: var(--color-ink-soft);">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full shrink-0" style="background-color: var(--color-teal);" />
                    {bullet}
                  </div>
                ))}
              </div>
              <p class="prose-body">{service.data.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
