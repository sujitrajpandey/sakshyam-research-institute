---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { slug: person.data.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const { data } = person;

const categoryLabel: Record<string, string> = {
  researcher: 'Researcher',
  management: 'Management',
  advisor: 'Advisor',
};
---

<Layout title={data.name} description={data.short_bio}>
  <section class="wrap pt-14 pb-20 md:pt-20 md:pb-24">
    <a href="/people" class="text-sm font-semibold mb-8 inline-flex items-center gap-1.5" style="color: var(--color-teal-deep);">
      ← Back to People
    </a>
    <div class="grid md:grid-cols-[280px_1fr] gap-10 md:gap-16 items-start">
      <div>
        <div class="aspect-square w-full rounded-2xl overflow-hidden section-soft mb-4">
          {data.photo && <img src={data.photo} alt={data.name} class="w-full h-full object-cover" />}
        </div>
        {data.linkedin_url && (
          <a href={data.linkedin_url} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold" style="color: var(--color-teal-deep);">
            LinkedIn →
          </a>
        )}
      </div>
      <div>
        <p class="eyebrow mb-4">{categoryLabel[data.category]}</p>
        <h1 class="h1 mb-2">{data.name}</h1>
        <p class="text-lg font-semibold mb-8" style="color: var(--color-teal-deep);">{data.role}</p>

        <div class="prose-body max-w-2xl mb-10">
          <p>{data.body}</p>
        </div>

        {data.expertise?.length > 0 && (
          <div>
            <h3 class="h4 mb-4">Areas of expertise</h3>
            <div class="flex flex-wrap gap-2">
              {data.expertise.map((item: string) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
