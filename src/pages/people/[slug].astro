---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const peopleEntries = await getCollection('people');
  return peopleEntries.map(person => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();
---
<Layout title={`${person.data.name} - Sakshyam Research Institute`}>
  <div class="max-w-4xl mx-auto py-16 px-4">
    <a href="/people" class="text-teal-600 hover:text-slate-900 mb-8 inline-block font-bold">&larr; Back to Our People</a>
    
    <div class="bg-white shadow-lg rounded-lg p-8 md:p-12 flex flex-col md:flex-row gap-12 items-start border-t-4 border-teal-600">
        
        <div class="w-48 h-48 rounded-full bg-gray-100 overflow-hidden border-4 border-background shrink-0 shadow-md mx-auto md:mx-0">
            {person.data.photo ? (
                <img src={person.data.photo} alt={person.data.name} class="w-full h-full object-cover" />
            ) : (
                <span class="text-6xl text-gray-400 mt-12 block text-center">👤</span>
            )}
        </div>
        
        <div class="flex-1 w-full">
            <h1 class="text-4xl font-heading font-bold text-slate-900 mb-2 text-center md:text-left">{person.data.name}</h1>
            
            <div class="text-center md:text-left mb-8">
                <span class="inline-block bg-teal-100 text-teal-800 px-4 py-1 rounded-full text-sm font-semibold tracking-wide">
                    {person.data.category}
                </span>
            </div>
            
            <div class="prose prose-lg text-slate-900 max-w-none space-y-4">
                <Content />
            </div>
        </div>

    </div>
  </div>
</Layout>
