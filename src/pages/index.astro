---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InsightCard from '../components/InsightCard.astro';

const homeEntry = await getEntry('home', 'index');
const home = homeEntry!.data;

/*
 * HERO WHITE OVERLAY OPACITY
 *
 * 0    = completely transparent
 * 0.10 = very subtle
 * 0.20 = light
 * 0.30 = moderate
 * 0.35 = current
 * 0.40 = stronger
 * 0.50 = very strong
 */
const heroOverlayOpacity = 0.55;

const allEvents = await getCollection('events');

const upcomingEvents = allEvents
  .filter((e) => e.data.type === 'upcoming')
  .sort((a, b) => a.data.order - b.data.order);

const pastEvents = allEvents
  .filter((e) => e.data.type === 'past')
  .sort((a, b) => a.data.order - b.data.order);

const orderedEvents = [...upcomingEvents, ...pastEvents].slice(0, 4);

const allProjects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const allInsights = (await getCollection('insights'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout title="Home">

  <!-- ========================================================= -->
  <!-- HERO -->
  <!-- ========================================================= -->

  <section class="relative overflow-hidden border-b border-line/70">

    <div class="relative min-h-[620px] md:min-h-[700px] lg:min-h-[760px]">

      <!-- Full-width hero image -->
      {
        home.hero.image && (
          <img
            src={home.hero.image}
            alt=""
            class="absolute inset-0 w-full h-full object-cover object-center"
            aria-hidden="true"
          />
        )
      }

      <!-- Hero content -->
      <div
        class="relative z-10 wrap min-h-[620px] md:min-h-[700px] lg:min-h-[760px] flex items-center"
      >

        <!-- Hero text area -->
        <div class="max-w-3xl py-15 md:py-21 lg:py-24">

          <!--
            FIXED-WIDTH WHITE OVERLAY

            The overlay no longer sizes itself according
            to the heading. Its width remains constant while
            the heading is being typed.
          -->
          <div
            class="hero-text-panel rounded-2xl px-6 py-7 md:px-8 md:py-9"
            style={`
              background: linear-gradient(
                90deg,
                rgba(255,255,255,${heroOverlayOpacity}),
                rgba(255,255,255,${heroOverlayOpacity * 0.70})
              );
            `}
          >

            <!-- Eyebrow -->
            {
              home.hero.eyebrow && (
                <p
                  class="eyebrow mb-6"
                  style="color: var(--color-ink);"
                >
                  {home.hero.eyebrow}
                </p>
              )
            }


            <!-- ================================================= -->
            <!-- HERO HEADING -->
            <!-- ================================================= -->

            <div class="hero-heading-container">

              <h1
                id="hero-heading"
                class="h1 max-w-3xl"
                style="color: var(--color-ink);"
              >
                {home.hero.heading}
              </h1>

            </div>


            <!-- Hero description -->
            <p
              class="lede mb-9 max-w-2xl"
              style="color: var(--color-ink);"
            >
              {home.hero.subheading}
            </p>


            <!-- Hero buttons -->
            <div class="flex flex-wrap gap-4">

              {
                home.hero.primary_button_label && (
                  <a
                    href={home.hero.primary_button_url}
                    class="btn btn-primary"
                  >
                    {home.hero.primary_button_label}
                    <span aria-hidden="true">→</span>
                  </a>
                )
              }

              {
                home.hero.secondary_button_label && (
                  <a
                    href={home.hero.secondary_button_url}
                    class="btn"
                    style="
                      background: rgba(255,255,255,0.55);
                      color: var(--color-ink);
                      border: 1px solid var(--color-ink);
                      backdrop-filter: blur(5px);
                    "
                  >
                    {home.hero.secondary_button_label}
                  </a>
                )
              }

            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- WHAT WE DO -->
  <!-- ========================================================= -->

  <section class="section-soft py-20 md:py-28">

    <div class="wrap">

      <div class="max-w-2xl mb-14">

        <p class="eyebrow mb-4">
          {home.what_we_do.eyebrow}
        </p>

        <h2 class="h2 mb-5">
          {home.what_we_do.heading}
        </h2>

        <p class="lede">
          {home.what_we_do.description}
        </p>

      </div>


      <div class="grid sm:grid-cols-3 gap-8">

        {
          home.what_we_do.pillars.map((pillar) => (
            <div class="card p-7 bg-white">

              <span
                class="font-heading text-3xl block mb-4"
                style="color: var(--color-teal-mid);"
              >
                {pillar.number}
              </span>

              <h3 class="h4 mb-2">
                {pillar.title}
              </h3>

              <p class="prose-body text-[0.95rem]">
                {pillar.description}
              </p>

            </div>
          ))
        }

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- EVENTS -->
  <!-- ========================================================= -->

  <section class="py-20 md:py-28">

    <div class="wrap">

      <div class="max-w-2xl mb-14">

        <p class="eyebrow mb-4">
          {home.events_section.eyebrow}
        </p>

        <h2 class="h2 mb-5">
          {home.events_section.heading}
        </h2>

        <p class="lede">
          {home.events_section.description}
        </p>

      </div>


      {
        orderedEvents.length > 0 ? (
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">

            {
              orderedEvents.map((event) => (
                <EventCard event={event.data} />
              ))
            }

          </div>
        ) : (
          <p class="prose-body">
            More events will be announced soon.
          </p>
        )
      }

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- SELECTED PROJECTS -->
  <!-- ========================================================= -->

  <section class="section-soft py-20 md:py-28">

    <div class="wrap">

      <div
        class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14"
      >

        <div class="max-w-2xl">

          <p class="eyebrow mb-4">
            {home.projects_section.eyebrow}
          </p>

          <h2 class="h2 mb-5">
            {home.projects_section.heading}
          </h2>

          <p class="lede">
            {home.projects_section.description}
          </p>

        </div>


        <a
          href="/projects"
          class="btn btn-outline bg-white shrink-0 w-fit"
        >
          {home.projects_section.button_label} →
        </a>

      </div>


      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

        {
          allProjects.map((project) => (
            <ProjectCard project={project} />
          ))
        }

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- LATEST INSIGHTS -->
  <!-- ========================================================= -->

  <section class="py-20 md:py-28">

    <div class="wrap">

      <div
        class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14"
      >

        <div class="max-w-2xl">

          <p class="eyebrow mb-4">
            {home.insights_section.eyebrow}
          </p>

          <h2 class="h2 mb-5">
            {home.insights_section.heading}
          </h2>

          <p class="lede">
            {home.insights_section.description}
          </p>

        </div>


        <a
          href="/insights"
          class="btn btn-outline shrink-0 w-fit"
        >
          {home.insights_section.button_label} →
        </a>

      </div>


      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

        {
          allInsights.map((insight) => (
            <InsightCard insight={insight} />
          ))
        }

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- CTA -->
  <!-- ========================================================= -->

  <section class="py-20 md:py-24">

    <div class="wrap">

      <div
        class="rounded-3xl px-8 py-16 md:px-16 md:py-20 text-center"
        style="background-color: var(--color-ink);"
      >

        <p
          class="eyebrow mb-5"
          style="color: var(--color-teal-light);"
        >
          {home.cta.eyebrow}
        </p>

        <h2 class="h2 mb-6 text-white">
          {home.cta.heading}
        </h2>

        <p class="lede mb-9 max-w-xl mx-auto text-white/70">
          {home.cta.description}
        </p>

        <a
          href={home.cta.button_url}
          class="btn"
          style="
            background-color: var(--color-teal);
            color: white;
          "
        >
          {home.cta.button_label} →
        </a>

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- TYPEWRITER ANIMATION -->
  <!-- ========================================================= -->

  <script>
    const heroHeading = document.getElementById('hero-heading');

    if (heroHeading) {

      const originalText = heroHeading.textContent?.trim() || '';

      /*
       * Accessibility:
       * screen readers still receive the complete heading.
       */
      heroHeading.setAttribute('aria-label', originalText);


      /*
       * Reserve the final height of the heading BEFORE
       * removing its text.
       */
      const headingContainer = heroHeading.parentElement;

      if (headingContainer) {

        const finalHeight =
          heroHeading.getBoundingClientRect().height;

        headingContainer.style.height =
          `${finalHeight}px`;
      }


      /*
       * Remove the original visible text.
       */
      heroHeading.textContent = '';


      /*
       * Create blinking cursor.
       */
      const cursor = document.createElement('span');

      cursor.setAttribute(
        'aria-hidden',
        'true'
      );

      cursor.className =
        'typing-cursor';


      heroHeading.appendChild(cursor);


      let index = 0;


      /*
       * Human-like typing speed.
       */
      const typingSpeed = 100;


      function typeNextCharacter() {

        if (index < originalText.length) {

          heroHeading.insertBefore(
            document.createTextNode(
              originalText.charAt(index)
            ),
            cursor
          );

          index++;

          window.setTimeout(
            typeNextCharacter,
            typingSpeed
          );

        } else {

          /*
           * Keep cursor blinking briefly after
           * typing has finished.
           */
          window.setTimeout(() => {

            cursor.classList.add(
              'typing-cursor-fade'
            );

            window.setTimeout(() => {

              cursor.remove();

            }, 600);

          }, 1200);

        }

      }


      /*
       * Short delay before typing begins.
       */
      window.setTimeout(
        typeNextCharacter,
        350
      );

    }
  </script>


  <!-- ========================================================= -->
  <!-- HERO / TYPEWRITER STYLES -->
  <!-- ========================================================= -->

  <style>

    /*
     * FIX 1:
     *
     * Fixed width for the white panel.
     *
     * The panel no longer expands as the heading
     * characters are progressively added.
     */

    .hero-text-panel {
      width: 100%;
      max-width: 760px;
    }


    /*
     * Desktop:
     * Keep the overlay at a stable width.
     */
    @media (min-width: 1024px) {

      .hero-text-panel {
        width: 760px;
      }

    }


    /*
     * Medium screens.
     */
    @media (min-width: 768px) and (max-width: 1023px) {

      .hero-text-panel {
        width: 680px;
        max-width: 100%;
      }

    }


    /*
     * Mobile:
     * Use the full available width with the
     * same fixed relationship to the viewport.
     */
    @media (max-width: 767px) {

      .hero-text-panel {
        width: 100%;
      }

    }


    /*
     * FIX 2:
     *
     * Reserve the completed heading's height.
     *
     * This prevents the subheading and buttons
     * from moving vertically while the heading
     * is being typed.
     */
    .hero-heading-container {
      margin-bottom: 1.75rem;
      overflow: visible;
    }


    /*
     * Typing cursor.
     */
    .typing-cursor {
      display: inline-block;

      width: 3px;

      height: 0.9em;

      margin-left: 5px;

      vertical-align: -0.05em;

      background-color: var(--color-teal);

      animation:
        typing-blink
        0.8s
        steps(1)
        infinite;
    }


    /*
     * Fade cursor after typing.
     */
    .typing-cursor-fade {

      opacity: 0;

      transition:
        opacity
        0.6s
        ease;

      animation: none;
    }


    /*
     * Cursor blink.
     */
    @keyframes typing-blink {

      0%,
      45% {
        opacity: 1;
      }

      46%,
      100% {
        opacity: 0;
      }

    }


    /*
     * Accessibility:
     * Disable cursor animation for users
     * who prefer reduced motion.
     */
    @media (prefers-reduced-motion: reduce) {

      .typing-cursor {
        display: none;
      }

    }

  </style>

</Layout>
