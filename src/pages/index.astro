---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const home = (await getCollection('pages')).find(p => p.data.pageType === 'home');
const events = (await getCollection('events')).sort((a,b) => a.data.date.valueOf() - b.data.date.valueOf());
const today = new Date(); today.setHours(0,0,0,0);
const upcoming = events.filter(e => e.data.date >= today).slice(0,2);
const past = events.filter(e => e.data.date < today).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0,2);
const projects = (await getCollection('projects')).filter(p => p.data.featured).slice(0,3);
const insights = (await getCollection('insights')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0,4);
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
---
<Layout title="Sakshyam Research Institute" description={home?.data.metaDescription}>
  <section class="hero-reference">
    <div class="hero-reference-inner container">
      <div class="hero-reference-copy">
        <h1>{home?.data.heroTitle}</h1>
        <div class="hero-reference-actions">
          <a class="btn primary" href="/projects">Explore our research</a>
          <a class="btn" href="/about#contact">Get in touch</a>
        </div>
      </div>
      <div class="hero-reference-art" aria-hidden="true"><img src="/media/hero-flow.svg" alt="" /></div>
    </div>
  </section>

  <section class="section context-section" id="what-we-do">
    <div class="container context-grid">
      <div class="context-intro">
        <div class="eyebrow">What we do</div>
        <h2>{home?.data.whatWeDoTitle}</h2>
        <p>{home?.data.whatWeDoText}</p>
      </div>
      <div class="context-cards">
        {home?.data.whatWeDoCards?.map((card, i) => <article class={`context-card context-card-${i}`}>
          <span class="context-icon">{card.number}</span><h3>{card.title}</h3><p>{card.text}</p>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section events-section" id="events">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Events</div><h2>{home?.data.eventsTitle}</h2><p>{home?.data.eventsIntro}</p></div></div>
      <div class="event-wrap">
        <div class="eyebrow">{home?.data.upcomingLabel}</div>
        <div class="grid event-grid" style="margin-top:18px">
          {upcoming.length ? upcoming.map(e => <article class="event"><div>{e.data.image ? <img class="event-image" src={e.data.image} alt="" /> : <div class="event-image" />}</div><div class="event-body"><span class="pill">{home?.data.upcomingLabel}</span><h3>{e.data.title}</h3><div class="event-meta">{fmtDate(e.data.date)}{e.data.time ? ` · ${e.data.time}` : ''}{e.data.location ? ` · ${e.data.location}` : ''}</div><p>{e.data.summary}</p>{e.data.rsvpEnabled && e.data.rsvpUrl ? <a class="btn primary" href={e.data.rsvpUrl}>RSVP →</a> : null}</div></article>) : <p>No upcoming events are currently listed. Check back soon.</p>}
        </div>
        <div class="eyebrow event-subhead">{home?.data.pastLabel}</div>
        <div class="grid event-grid" style="margin-top:18px">
          {past.length ? past.map(e => <article class="event"><div>{e.data.image ? <img class="event-image" src={e.data.image} alt="" /> : <div class="event-image" />}</div><div class="event-body"><span class="pill">{home?.data.pastLabel}</span><h3>{e.data.title}</h3><div class="event-meta">{fmtDate(e.data.date)}{e.data.time ? ` · ${e.data.time}` : ''}{e.data.location ? ` · ${e.data.location}` : ''}</div><p>{e.data.summary}</p></div></article>) : <p>No past events are currently listed.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Selected work</div><h2>{home?.data.selectedWorkTitle}</h2><p>{home?.data.selectedWorkIntro}</p></div><a class="btn" href="/projects">View projects →</a></div><div class="grid project-grid">{projects.map(p => <a class="project" href={`/projects/${p.id}`}><div>{p.data.image ? <img class="project-image" src={p.data.image} alt="" /> : <div class="project-image" />}</div><div class="project-body"><span class="pill">{p.data.status || 'Project'}</span><h3>{p.data.title}</h3><p>{p.data.summary}</p></div></a>)}</div></div></section>

  <section class="section" style="padding-top:20px"><div class="container"><div class="section-head"><div><div class="eyebrow">Latest insights</div><h2>{home?.data.insightsTitle}</h2><p>{home?.data.insightsIntro}</p></div><a class="btn" href="/insights">All insights →</a></div><div class="grid insight-grid">{insights.map(i => <a class="insight" href={`/insights/${i.id}`}><span class="pill">{i.data.type}</span><h3>{i.data.title}</h3><p>{i.data.excerpt}</p><small>{fmtDate(i.data.date)}</small></a>)}</div></div></section>

  <section class="section"><div class="container"><div class="cta"><div class="cta-inner"><div><div class="eyebrow" style="color:rgba(154,208,214,.95)">Collaborate with us</div><h2>{home?.data.ctaTitle}</h2><p>{home?.data.ctaText}</p></div><a class="btn" style="background:white;border-color:white" href={home?.data.ctaUrl}>{home?.data.ctaLabel}</a></div></div></div></section>
</Layout>
