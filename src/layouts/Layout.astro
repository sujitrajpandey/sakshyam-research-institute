---
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const settingsEntry = await getEntry('settings', 'general');
const settings = settingsEntry!.data;

const fontMap: Record<string, string> = {
  Fraunces: 'Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700',
  'Playfair Display': 'Playfair+Display:wght@500;600;700',
  Lora: 'Lora:wght@500;600;700',
  'Space Grotesk': 'Space+Grotesk:wght@500;600;700',
  Inter: 'Inter:wght@400;500;600;700',
  'Source Sans 3': 'Source+Sans+3:wght@400;500;600;700',
  'Work Sans': 'Work+Sans:wght@400;500;600;700',
  'Nunito Sans': 'Nunito+Sans:wght@400;500;600;700',
};

const headingFontParam = fontMap[settings.typography.heading_font] ?? fontMap['Fraunces'];
const bodyFontParam = fontMap[settings.typography.body_font] ?? fontMap['Inter'];
const googleFontsHref = `https://fonts.googleapis.com/css2?family=${headingFontParam}&family=${bodyFontParam}&display=swap`;

const pageTitle = title ? `${title} — ${settings.site_title}` : settings.site_title;
const pageDescription = description || settings.tagline;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={settings.favicon || '/favicon.png'} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={settings.logo} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={googleFontsHref} />

    <style set:html={`
      :root {
        --color-ink: ${settings.colors.ink};
        --color-ink-soft: ${settings.colors.ink_soft};
        --color-teal-deep: ${settings.colors.teal_deep};
        --color-teal: ${settings.colors.teal};
        --color-teal-mid: ${settings.colors.teal_mid};
        --color-teal-light: ${settings.colors.teal_light};
        --color-bg: ${settings.colors.bg};
        --color-bg-soft: ${settings.colors.bg_soft};
        --color-line: ${settings.colors.line};
        --font-heading: '${settings.typography.heading_font}';
        --font-body: '${settings.typography.body_font}';
        --base-px: ${settings.typography.base_font_size}px;
        --heading-scale: ${settings.typography.heading_scale};
        --body-lh: ${settings.typography.body_line_height};
      }
    `} />
  </head>
  <body>
    <Header settings={settings} />
    <main>
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
