---
interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Sakshyam Research Institute" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/favicon.png" />
		<title>{title}</title>
	</head>
	<body class="bg-background font-sans text-slate-900">
        <nav class="bg-white shadow-sm p-4 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <a href="/">
                    <img src="/images/Full Logo.png" alt="Sakshyam Research Institute" class="h-12" />
                </a>
                <div class="space-x-6 font-bold text-slate-900">
                    <a href="/" class="hover:text-teal-600">Home</a>
                    <a href="/projects" class="hover:text-teal-600">Projects</a>
                    <a href="/people" class="hover:text-teal-600">People</a>
                </div>
            </div>
        </nav>
		<slot />
        <footer class="bg-slate-900 text-white py-8 text-center mt-12">
            <p>&copy; {new Date().getFullYear()} Sakshyam Research Institute. All rights reserved.</p>
        </footer>
	</body>
</html>
