---
import '../styles/global.css';
import { getEntry } from 'astro:content';
const siteEntry = await getEntry('site', 'site');
const site = siteEntry.data;
const { title = site.site_title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content={site.colors.primary} />
<link rel="icon" href={site.favicon || site.symbol} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
</head>
<body style={`--primary:${site.colors.primary};--primary-dark:${site.colors.primary_dark};--accent:${site.colors.accent};--accent-light:${site.colors.accent_light};--surface:${site.colors.surface};--background:${site.colors.background};--text:${site.colors.text};--muted:${site.colors.muted};--border:${site.colors.border};--light-text:${site.colors.light_text};--logo-width:${site.logo_width || 155}px`}>
<header class="site-header"><div class="container nav-wrap">
<a class="brand" href="/"><img src={site.logo} alt={site.site_title} /><span><strong>{site.short_name}</strong><small>Research Institute</small></span></a>
<button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">☰</button>
<nav class="nav"><a href="/about">About</a><a href="/research">Research</a><a href="/projects">Projects</a><a href="/services">Services</a><a href="/insights">Insights</a><a href="/people">People</a><a href="/resources">Resources</a><a class="nav-cta" href="/contact">Get in touch</a></nav>
</div></header>
<main><slot /></main>
<footer class="footer"><div class="container footer-grid"><div><img class="footer-logo" src={site.footer_logo || site.logo} alt={site.site_title}/><p class="footer-copy">{site.tagline}. {site.description}</p></div><div><h4>Explore</h4><a href="/about">About</a><a href="/research">Research</a><a href="/projects">Projects</a><a href="/services">Services</a><a href="/insights">Insights</a></div><div><h4>Resources</h4><a href="/people">People</a><a href="/resources">Publications</a><a href="/contact">Contact</a></div><div><h4>Contact</h4><p>{site.address}</p><p>{site.email}</p><p>{site.phone_primary}</p><div class="socials"><a href={site.linkedin} aria-label="LinkedIn">in</a></div></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.site_title}</span><span>{site.tagline}</span></div></footer>
<script>const toggle=document.querySelector('.menu-toggle');const nav=document.querySelector('.nav');toggle?.addEventListener('click',()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));});</script>
</body></html>
